<%# Partial _panel.html.erb %>
<%# Locals: client, whatsapp_instance (pode ser nil), reusable_targets (fase 31,
    D-06 — só relevante quando whatsapp_instance é nil; array de
    {instance_name:, client_names:}) %>
<%# Card "WhatsApp" completo — empty-state, badge de estado, QR + banner de banimento,
    cautela de idade e ações (Forçar verificação / Parear novamente). 26-UI-SPEC. %>
<% reusable_targets ||= [] %>

<div class="bg-white rounded-xl border border-gray-200 shadow-card p-6 max-w-2xl mt-4">
  <h2 class="text-sm font-semibold text-slate-900 border-b border-gray-100 pb-3 mb-4">WhatsApp</h2>

  <% if whatsapp_instance.nil? %>
    <div class="py-10" data-controller="whatsapp-provision-toggle">
      <div class="text-center mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto text-slate-300 mb-4" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-4 4v-4z" />
        </svg>
        <h3 class="text-sm font-semibold text-slate-900 mb-1">Nenhuma instância de WhatsApp</h3>
        <p class="text-sm text-slate-500">Sem instância pareada, este cliente não pode receber disparos.</p>
      </div>

      <div class="flex justify-center gap-3 mb-5">
        <label data-whatsapp-provision-toggle-target="newLabel"
               class="cursor-pointer flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-200 text-sm font-medium transition-colors">
          <%= radio_button_tag "provision_mode", "new", true,
                class: "sr-only",
                data: { action: "whatsapp-provision-toggle#selectNew", "whatsapp-provision-toggle-target": "newRadio" } %>
          Novo número (QR)
        </label>
        <label data-whatsapp-provision-toggle-target="reuseLabel"
               class="cursor-pointer flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-200 text-sm font-medium transition-colors">
          <%= radio_button_tag "provision_mode", "reuse", false,
                class: "sr-only",
                data: { action: "whatsapp-provision-toggle#selectReuse", "whatsapp-provision-toggle-target": "reuseRadio" } %>
          Reutilizar conexão existente
        </label>
      </div>

      <div data-whatsapp-provision-toggle-target="newField" class="text-center">
        <%= button_to "Criar instância", admin_client_whatsapp_instance_path(client),
              method: :post,
              class: "h-10 px-4 bg-[#0F7949] hover:bg-[#0a5c37] active:scale-[0.99] text-white text-sm font-semibold rounded-lg transition-colors inline-flex items-center" %>
      </div>

      <div data-whatsapp-provision-toggle-target="reuseField" class="hidden max-w-md mx-auto text-center">
        <p class="text-sm text-slate-500 mb-4">
          "Reutilizar" vincula este cliente ao MESMO número físico e MESMA sessão de
          WhatsApp de outro(s) cliente(s) — não é um número novo. A conexão, o
          histórico de conversa e o limite de envio passam a ser compartilhados.
        </p>
        <% if reusable_targets.blank? %>
          <p class="text-sm text-slate-500">Nenhuma conexão conectada disponível para reutilizar.</p>
        <% else %>
          <%= form_with url: reuse_admin_client_whatsapp_instance_path(client), method: :post, local: true do |f| %>
            <%= f.select :source_instance_name,
                  reusable_targets.map { |t| ["#{t[:instance_name]} — usado por: #{t[:client_names].join(', ')}", t[:instance_name]] },
                  { include_blank: "Selecione uma conexão" },
                  id: "source_instance_name",
                  data: { action: "whatsapp-provision-toggle#toggleSubmitState", "whatsapp-provision-toggle-target": "reuseSelect" },
                  class: "block w-full h-11 px-3 mb-4 border border-gray-200 rounded-lg text-sm text-slate-900 bg-white focus:outline-none focus:border-[#0F7949] focus:ring-2 focus:ring-[#0F7949]/10 transition-colors" %>
            <%= f.submit "Reutilizar conexão",
                  disabled: true,
                  data: {
                    "whatsapp-provision-toggle-target": "reuseSubmit",
                    turbo_confirm: "Isto vincula ESTE cliente ao MESMO número físico de WhatsApp já usado por outro(s) cliente(s): a mesma sessão e o mesmo limite de envio passam a ser compartilhados. Confirmar?",
                    turbo_submits_with: "Vinculando…"
                  },
                  class: "h-10 px-4 bg-[#0F7949] hover:bg-[#0a5c37] active:scale-[0.99] text-white text-sm font-semibold rounded-lg transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <dl class="space-y-3">
      <div class="flex items-center gap-4">
        <dt class="text-sm font-medium text-slate-500 w-36">Estado</dt>
        <dd><%= render "admin/whatsapp_instances/connection_badge", whatsapp_instance: whatsapp_instance %></dd>
      </div>
      <div class="flex items-center gap-4">
        <dt class="text-sm font-medium text-slate-500 w-36">Última verificação</dt>
        <dd class="text-sm text-slate-700" title="<%= whatsapp_instance.last_checked_at&.iso8601 %>">
          <%= wa_last_checked_label(whatsapp_instance) %>
        </dd>
      </div>
    </dl>
    <% if whatsapp_instance.shared? %><p class="text-sm text-slate-500 mt-3">Conexão compartilhada com <%= whatsapp_instance.siblings.where.not(id: whatsapp_instance.id).count %> cliente(s).</p><% end %>

    <% if whatsapp_instance.connected? %>
      <% if whatsapp_instance.origin_adopted_existing? %>
        <p class="text-sm text-slate-700 mt-3">Conectada (instância adotada). O webhook foi reapontado para este sistema.</p>
      <% elsif whatsapp_instance.paired_days && whatsapp_instance.paired_days < 1 %>
        <p class="text-sm text-slate-700 mt-3">Conectada. Pareado agora há pouco.</p>
      <% elsif !whatsapp_instance.recently_paired? && wa_paired_age_text(whatsapp_instance) %>
        <p class="text-sm text-slate-700 mt-3"><%= wa_paired_age_text(whatsapp_instance) %></p>
      <% end %>

      <% if whatsapp_instance.recently_paired? %>
        <p class="bg-[#FFFBEB] border border-[#F59E0B]/20 text-amber-800 text-sm rounded-lg p-3 leading-relaxed mt-3">
          <%= wa_paired_age_text(whatsapp_instance) %>
        </p>
      <% end %>
    <% elsif whatsapp_instance.awaiting_qr? %>
      <% if whatsapp_instance.origin_adopted_existing? %>
        <p class="text-sm text-slate-700 mt-3 mb-3">Instância adotada, mas ainda não conectada. Escaneie o QR abaixo para parear.</p>
      <% end %>
      <div class="mt-3">
        <%= render "admin/whatsapp_instances/qr", instance: whatsapp_instance %>
      </div>
    <% end %>

    <div class="flex items-center gap-3 mt-5 pt-4 border-t border-gray-100">
      <%= button_to "Forçar verificação", verify_admin_client_whatsapp_instance_path(client),
            method: :post,
            data: { turbo_submits_with: "Verificando…" },
            class: "inline-flex items-center h-9 px-3 border border-gray-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-gray-50 transition-colors" %>

      <%# Sincronização de grupos (GRUPO-01, 27-02) — botão desabilitado NUNCA
          enfileira (o guard server-side do #sync é a defesa real, este disabled
          é só affordance). Secundário aqui: o CTA primário verde fica reservado
          para a página de grupos (empty state 2 / header nunca sincronizado). %>
      <%= button_to "Sincronizar grupos", sync_admin_client_whatsapp_groups_path(client),
            method: :post,
            data: { turbo_submits_with: "Sincronizando…" },
            disabled: !whatsapp_instance.connected?,
            class: "inline-flex items-center h-9 px-3 border border-gray-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" %>

      <%= link_to "Ver grupos", admin_client_whatsapp_groups_path(client),
            class: "text-[#0F7949] hover:underline text-sm" %>

      <% if whatsapp_instance.connected? || whatsapp_instance.disconnected? %>
        <div data-controller="modal">
          <button type="button"
                  data-action="click->modal#open"
                  class="inline-flex items-center h-9 px-3 border border-gray-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-gray-50 transition-colors">
            Parear novamente
          </button>
          <%# 31-REVIEW.md WR-03: o corpo do modal avisa do "blast radius" real
              quando a conexão é compartilhada -- `reconnect` chama
              Evolution::Client.connect(inst.instance_name), que encerra a
              sessão FÍSICA, derrubando TODOS os clientes-irmãos que usam o
              mesmo instance_name, não só este. Mesma lógica que o modal de
              "Reutilizar conexão existente" (linha ~65) já aplica. %>
          <%= render "admin/clients/confirm_modal",
                id: "reconnect-modal",
                title: "Parear novamente",
                body: (whatsapp_instance.shared? ?
                        "Parear novamente encerra a sessão atual do WhatsApp deste número. " \
                        "Esta conexão é compartilhada com #{whatsapp_instance.siblings.where.not(id: whatsapp_instance.id).count} outro(s) cliente(s) — " \
                        "os disparos ficam indisponíveis para TODOS eles, não só para este cliente, até um novo pareamento ser concluído." :
                        "Parear novamente encerra a sessão atual do WhatsApp deste número. Os disparos ficam indisponíveis até um novo pareamento ser concluído."),
                confirm_label: "Parear novamente",
                cancel_label: "Manter conexão atual",
                confirm_variant: "warning",
                form_action: reconnect_admin_client_whatsapp_instance_path(client),
                method: :post %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
