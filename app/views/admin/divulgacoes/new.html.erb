<% content_for(:page_title) { "Nova divulgação" } %>

<div class="mb-4">
  <%= link_to admin_client_path(@client),
        class: "inline-block text-sm text-slate-600 hover:text-slate-900 truncate max-w-[280px] sm:max-w-md" do %>
    ← <%= @client.name %>
  <% end %>
</div>

<h1 class="text-2xl font-semibold text-slate-900 mb-6">Nova divulgação</h1>

<% if @instance.nil? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-card p-8 max-w-2xl mt-4">
    <div class="py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto text-slate-300 mb-4" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-4 4v-4z" />
      </svg>
      <h2 class="text-lg font-semibold text-slate-900 mb-1">Nenhuma instância de WhatsApp</h2>
      <p class="text-sm text-slate-500 mb-6">Este cliente ainda não tem um número pareado. Pareie o WhatsApp deste cliente antes de agendar uma divulgação.</p>
      <%= link_to "Ir para o pareamento", admin_client_path(@client),
            class: "h-10 px-4 bg-[#0F7949] hover:bg-[#0a5c37] active:scale-[0.99] text-white text-sm font-semibold rounded-lg transition-colors inline-flex items-center" %>
    </div>
  </div>
<% elsif @approved_artes.empty? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-card p-8 max-w-2xl mt-4">
    <div class="py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto text-slate-300 mb-4" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <h2 class="text-lg font-semibold text-slate-900 mb-1">Nenhuma arte aprovada</h2>
      <p class="text-sm text-slate-500 mb-6">Este cliente não tem nenhuma arte aprovada. Aprove uma arte antes de agendar uma divulgação.</p>
      <%= link_to "Ver artes do cliente", admin_artes_path(client_id: @client.id),
            class: "inline-flex items-center h-9 px-3 border border-gray-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-gray-50 transition-colors" %>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-card p-8 max-w-2xl mt-4">
    <%= form_with model: [ :admin, @client, @divulgacao ],
          html: { data: { controller: "divulgacao-preview" } } do |f| %>
      <% unless @instance.connected? %>
        <div class="mb-4">
          <p class="bg-[#FFFBEB] border border-[#F59E0B]/20 text-amber-800 text-sm rounded-lg p-3 leading-relaxed">
            A instância de WhatsApp deste cliente está desconectada. Reconecte o número antes de agendar uma divulgação.
            <%= link_to "Ir para o pareamento", admin_client_path(@client), class: "text-[#0F7949] hover:underline font-medium" %>
          </p>
          <span class="mt-2 inline-block"><%= render "admin/whatsapp_instances/connection_badge", whatsapp_instance: @instance %></span>
        </div>
      <% end %>

      <% if flash.now[:alert].present? %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          <p><%= flash.now[:alert] %></p>
        </div>
      <% end %>

      <% if @divulgacao.errors[:base].any? %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          <% @divulgacao.errors[:base].each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :arte_id, "Arte aprovada", class: "block text-sm font-medium text-slate-900 mb-1.5" %>
        <%= f.collection_select :arte_id, @approved_artes, :id,
              ->(a) { "#{a.title.presence || 'Arte'} — #{l(a.scheduled_on)}" },
              { prompt: "Selecione uma arte aprovada" },
              class: "block w-full h-11 px-3 border border-gray-200 rounded-lg text-sm text-slate-900 bg-white focus:outline-none focus:border-[#0F7949] focus:ring-2 focus:ring-[#0F7949]/20 transition-colors",
              data: { action: "change->divulgacao-preview#show" } %>
      </div>

      <%# Wrapper do divulgacao-estimate: e o unico elemento que contem as caixas de %>
      <%# grupo E o <span> alvo do texto, entao min/max-value + os targets vivem AQUI %>
      <%# (Stimulus le static values do proprio elemento do controller, nao de %>
      <%# descendentes — ver 28-03-SUMMARY "Deviations"). %>
      <div data-controller="divulgacao-estimate"
           data-divulgacao-estimate-min-value="<%= Divulgacao::SEND_DELAY_MIN %>"
           data-divulgacao-estimate-max-value="<%= Divulgacao::SEND_DELAY_MAX %>">

        <div class="mb-4">
          <span class="block text-sm font-medium text-slate-900 mb-1.5">Grupos</span>
          <div data-controller="picker"
               data-action="change->divulgacao-estimate#recompute change->picker#refresh"
               class="border border-gray-200 rounded-lg max-h-[380px] overflow-y-auto">
            <%= render "admin/whatsapp_groups/picker",
                  client:       @client,
                  selected_ids: (@divulgacao.divulgacao_grupos.map(&:whatsapp_group_id).presence || []),
                  field_name:   "divulgacao[whatsapp_group_ids][]" %>
          </div>
        </div>

        <div class="mb-6">
          <%= f.label :scheduled_for, "Data e hora do envio (America/São_Paulo)", class: "block text-sm font-medium text-slate-900 mb-1.5" %>
          <%= f.datetime_field :scheduled_for,
                min: Time.current,
                class: "block w-full h-11 px-3 border border-gray-200 rounded-lg text-sm text-slate-900 bg-white focus:outline-none focus:border-[#0F7949] focus:ring-2 focus:ring-[#0F7949]/20 transition-colors" %>
          <p class="text-xs text-slate-500 mt-1">Interpretada no fuso de Brasília (BRT).</p>
        </div>

        <div class="mb-4">
          <p class="text-xs text-slate-500">Estimativa de duração</p>
          <p class="text-sm font-semibold text-slate-900"><span data-divulgacao-estimate-target="text"><%= divulgacao_duration_estimate(@divulgacao.divulgacao_grupos.size) %></span></p>
          <p class="text-xs text-slate-400">Tempo aproximado do disparo, do primeiro ao último grupo.</p>
        </div>
      </div>

      <div class="mb-6">
        <p class="text-xs font-medium text-slate-500 mb-2">Prévia — é exatamente isto que vai ao grupo</p>
        <% @approved_artes.each do |a| %>
          <div data-divulgacao-preview-target="pane" data-arte-id="<%= a.id %>" class="hidden">
            <%= render "preview", arte: a %>
          </div>
        <% end %>
        <div data-divulgacao-preview-target="placeholder" class="text-sm text-slate-500">
          Selecione uma arte para ver a prévia.
        </div>
      </div>

      <% submit_disabled = !@instance.connected? || @client.whatsapp_instance.whatsapp_groups.where(active: true).none? %>
      <%= f.submit "Agendar divulgação",
            disabled: submit_disabled,
            data: { turbo_submits_with: "Agendando…" },
            class: "h-10 px-4 bg-[#0F7949] hover:bg-[#0a5c37] active:scale-[0.99] text-white text-sm font-semibold rounded-lg transition-colors inline-flex items-center cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
    <% end %>
  </div>
<% end %>
