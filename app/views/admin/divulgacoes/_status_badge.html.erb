<%# Partial _status_badge.html.erb %>
<%# Locals: divulgacao: — mapeia divulgacoes.status pra paleta canonica do %>
<%# 28-UI-SPEC "Status → pill palette map". Mesma forma de pill + glifo ● que %>
<%# admin/whatsapp_groups/show.html.erb. %>
<% case divulgacao.status %>
<% when "agendada" %>
  <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium border bg-[#F0FDF4] text-[#14A958] border-[#14A958]/20">
    <span aria-hidden="true">●</span> Agendada
  </span>
<% when "cancelada" %>
  <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium border bg-[#FEF2F2] text-[#EE3537] border-[#EE3537]/20">
    <span aria-hidden="true">●</span> Cancelada
  </span>
<% when "em_andamento" %>
  <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium border bg-[#FFFBEB] text-amber-800 border-[#F59E0B]/20">
    <span aria-hidden="true">●</span> Em andamento
  </span>
<% when "concluida" %>
  <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium border bg-slate-100 text-slate-600 border-slate-200">
    <span aria-hidden="true">●</span> Concluída
  </span>
<% end %>
