<%# Partial _preview.html.erb — prévia do que vai ao grupo (DIVU-06). %>
<%# Locals: arte: (Arte). Sem JS. Renderiza a MÍDIA REAL pela rota proxy do %>
<%# ActiveStorage (auth-gated, faz stream do blob; sem presign, sem link que %>
<%# expira enquanto o admin preenche o form) e a LEGENDA VERBATIM. %>
<%# A legenda é impressa pelo ERB, que auto-escapa; nenhum bypass de escape. %>
<%# whitespace-pre-wrap é só CSS (preserva quebras de linha). %>
<div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
  <% if arte.media_file.attached? && arte.media_file.image? %>
    <%= image_tag rails_storage_proxy_path(arte.media_file),
          loading: "lazy",
          alt: "Prévia da mídia da divulgação",
          class: "max-w-full max-h-[420px] object-contain mx-auto block rounded" %>
  <% elsif arte.media_file.attached? && arte.media_file.video? %>
    <video controls playsinline preload="none"
           class="max-w-full max-h-[420px] block mx-auto rounded">
      <source src="<%= rails_storage_proxy_path(arte.media_file) %>" type="<%= arte.media_file.content_type %>">
      Seu navegador não suporta reprodução de vídeo.
    </video>
  <% else %>
    <%# caption_only — sem media_file. DIVU-04 (teto) não se aplica (sem arquivo). %>
    <p class="text-sm text-slate-500 italic">(sem mídia — mensagem de texto)</p>
  <% end %>

  <% if arte.caption.present? %>
    <div class="mt-3 pt-3 border-t border-gray-200">
      <p class="text-xs font-medium text-slate-500 mb-1">Legenda (enviada sem alteração):</p>
      <p class="text-sm text-slate-800 leading-relaxed whitespace-pre-wrap max-h-64 overflow-y-auto"><%= arte.caption %></p>
    </div>
  <% end %>
</div>
