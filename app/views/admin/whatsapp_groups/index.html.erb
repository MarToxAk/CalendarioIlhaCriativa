<%# Locals: @client, @instance, @active_groups, @inactive_groups, @pagy — vindos de %>
<%# Admin::WhatsappGroupsController#index. Página nunca chama o Evolution -- lê SOMENTE %>
<%# o cache local (GRUPO-02/SC2). Cobre todos os estados do 27-UI-SPEC. %>
<% content_for(:page_title) { "Grupos do WhatsApp" } %>

<h1 class="text-2xl font-semibold text-slate-900 mb-6">Grupos do WhatsApp</h1>

<%= link_to "← #{@client.name}", admin_client_path(@client), class: "text-sm text-slate-600 mb-4 inline-block truncate max-w-[280px] sm:max-w-md" %>

<div class="bg-white rounded-xl border border-gray-200 shadow-card p-6 max-w-2xl"
     <% if @instance %>
       data-controller="group-sync"
       data-group-sync-status-url-value="<%= sync_status_admin_client_whatsapp_groups_path(@client) %>"
       data-group-sync-since-value="<%= @instance.groups_synced_at&.iso8601 %>"
     <% end %>>
  <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-4">
    <div class="flex items-center">
      <h2 class="text-sm font-semibold text-slate-900">Grupos</h2>
      <span class="ml-2"><%= render "admin/whatsapp_instances/connection_badge", whatsapp_instance: @instance %></span>
    </div>

    <% if @instance %>
      <% if @instance.groups_synced_at.nil? %>
        <%= button_to "Sincronizar grupos", sync_admin_client_whatsapp_groups_path(@client),
              method: :post,
              disabled: !@instance.connected?,
              data: { turbo_submits_with: "Sincronizando…" },
              class: "h-10 px-4 bg-[#0F7949] hover:bg-[#0a5c37] active:scale-[0.99] text-white text-sm font-semibold rounded-lg transition-colors inline-flex items-center disabled:opacity-50 disabled:cursor-not-allowed" %>
      <% else %>
        <%= button_to "Sincronizar grupos", sync_admin_client_whatsapp_groups_path(@client),
              method: :post,
              disabled: !@instance.connected?,
              data: { turbo_submits_with: "Sincronizando…" },
              class: "inline-flex items-center h-9 px-3 border border-gray-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" %>
      <% end %>
    <% end %>
  </div>

  <% if @instance %>
    <div class="mb-4">
      <p class="text-xs font-medium text-slate-500">Sincronizado pela última vez em <%= wa_groups_synced_label(@instance) %></p>
      <span aria-live="polite" class="sr-only" data-group-sync-target="status"></span>
    </div>
  <% end %>

  <% if @instance.nil? %>
    <div class="py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto text-slate-300 mb-4" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-4 4v-4z" />
      </svg>
      <h3 class="text-sm font-semibold text-slate-900 mb-1">Nenhuma instância de WhatsApp</h3>
      <p class="text-sm text-slate-500 mb-6">Este cliente ainda não tem um número pareado. Pareie o WhatsApp deste cliente antes de sincronizar os grupos.</p>
      <%= link_to "Ir para o pareamento", admin_client_path(@client),
            class: "h-10 px-4 bg-[#0F7949] hover:bg-[#0a5c37] active:scale-[0.99] text-white text-sm font-semibold rounded-lg transition-colors inline-flex items-center" %>
    </div>
  <% else %>
    <% unless @instance.connected? %>
      <p class="bg-[#FFFBEB] border border-[#F59E0B]/20 text-amber-800 text-sm rounded-lg p-3 leading-relaxed mb-4">
        A instância está desconectada. Reconecte o número antes de sincronizar os grupos.
        <%= link_to "Ir para o pareamento", admin_client_path(@client), class: "text-[#0F7949] hover:underline font-medium" %>
      </p>
    <% end %>

    <div data-group-sync-target="error" class="<%= "hidden " unless @instance.groups_sync_error.present? %>bg-[#FEF2F2] text-[#EE3537] border border-[#EE3537]/20 text-sm rounded-lg p-3 leading-relaxed mb-4">
      <%= wa_groups_sync_error_message(@instance) %>
    </div>

    <% if @instance.connected? && @instance.groups_synced_at.nil? %>
      <div class="py-16 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto text-slate-300 mb-4" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 100-8 4 4 0 000 8zm6 3c0-1.657-3.582-3-8-3s-8 1.343-8 3" />
        </svg>
        <h3 class="text-sm font-semibold text-slate-900 mb-1">Nenhum grupo sincronizado ainda</h3>
        <p class="text-sm text-slate-500 mb-6">Clique em &quot;Sincronizar grupos&quot; para buscar os grupos deste número no WhatsApp. Isso pode levar alguns segundos.</p>
        <%= button_to "Sincronizar grupos", sync_admin_client_whatsapp_groups_path(@client),
              method: :post,
              data: { turbo_submits_with: "Sincronizando…" },
              class: "h-10 px-4 bg-[#0F7949] hover:bg-[#0a5c37] active:scale-[0.99] text-white text-sm font-semibold rounded-lg transition-colors inline-flex items-center" %>
      </div>
    <% elsif @instance.groups_synced_at.present? && @active_groups.blank? && @inactive_groups.blank? %>
      <div class="py-16 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto text-slate-300 mb-4" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 100-8 4 4 0 000 8zm6 3c0-1.657-3.582-3-8-3s-8 1.343-8 3" />
        </svg>
        <h3 class="text-sm font-semibold text-slate-900 mb-1">Nenhum grupo neste número</h3>
        <p class="text-sm text-slate-500 mb-6">A última sincronização em <%= wa_groups_synced_label(@instance) %> não encontrou nenhum grupo. Se o número participa de grupos, confira no celular e sincronize de novo.</p>
        <%= button_to "Sincronizar grupos", sync_admin_client_whatsapp_groups_path(@client),
              method: :post,
              data: { turbo_submits_with: "Sincronizando…" },
              class: "inline-flex items-center h-9 px-3 border border-gray-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-gray-50 transition-colors" %>
      </div>
    <% else %>
      <%= render "admin/whatsapp_groups/picker", client: @client, selected_ids: [], field_name: nil, pagy: @pagy %>

      <% if @inactive_groups.present? %>
        <div class="mt-6 pt-4 border-t border-gray-100">
          <p class="text-xs font-medium text-slate-400 uppercase tracking-wide">Grupos inativos</p>
          <p class="text-xs text-slate-400 mt-1 mb-3">Preservados para o histórico. Não podem ser selecionados.</p>
          <ul>
            <% @inactive_groups.each do |g| %>
              <li class="flex items-center gap-3 py-3 px-4 border-b border-gray-100 last:border-0 text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="text-slate-300 shrink-0" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-sm truncate" title="<%= g.display_name %>"><%= g.display_name %></span>
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium border bg-slate-100 text-slate-600 border-slate-200 shrink-0">
                  <span aria-hidden="true">●</span> Inativo
                </span>
                <span class="text-xs text-slate-400 ml-auto">Sumiu do WhatsApp na última sincronização</span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>

    <p data-group-sync-target="timeout" class="hidden text-sm text-slate-500 mt-4">
      A sincronização está demorando. Atualize a página para ver o resultado.
      <%= link_to "Atualizar", admin_client_whatsapp_groups_path(@client), class: "text-[#0F7949] hover:underline" %>
    </p>
  <% end %>
</div>
