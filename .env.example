# Copie para .env e preencha os valores

# Chave mestra do Rails (valor em config/master.key)
RAILS_MASTER_KEY=cole_aqui_o_conteudo_do_master_key

# Senha do banco PostgreSQL (escolha uma senha forte)
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# --- Evolution API (transporte WhatsApp) - fase 25 ---
# URL base do host Evolution da agencia; https:// obrigatorio (TLS terminado na frente).
# OBRIGATORIA em prod (boot-fatal se ausente); sem fallback para credentials.yml.enc.
EVOLUTION_BASE_URL=
# Chave global da API Evolution, enviada no header apikey. Segredo - use canal seguro.
# OBRIGATORIA em prod (boot-fatal); segredo - use canal seguro.
EVOLUTION_GLOBAL_API_KEY=
# Timeouts do Faraday em segundos (opcionais - o codigo tem defaults 5 / 10 / 30).
EVOLUTION_OPEN_TIMEOUT=5
EVOLUTION_WRITE_TIMEOUT=10
EVOLUTION_READ_TIMEOUT=30

# --- Object storage (MinIO / S3-compativel) - fase 25 / INFRA-01 ---
# Endpoint HTTPS do MinIO (mesmo endpoint em dev e prod; o bucket e derivado de Rails.env).
# OBRIGATORIA em prod (boot-fatal). As chaves AWS_* abaixo tambem vem so de ENV agora.
S3_ENDPOINT=
# Credenciais do bucket S3/MinIO (privado). OBRIGATORIAS em prod; antes eram credentials-only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Regiao (MinIO ignora, mas o SDK exige um valor). Default us-east-1 se ausente.
AWS_REGION=

# --- Timezone - fase 25 / INFRA-03 ---
# Fuso do container. timezone_check.rb aborta o boot em producao se != America/Sao_Paulo
# (config.active_record.default_timezone = :local exige TZ fixo).
TZ=America/Sao_Paulo

# CORS_ORIGINS: obrigatoria em producao — config/application.rb faz ENV.fetch("CORS_ORIGINS")
# sem default em producao (KeyError se ausente). Origin publica desta topologia (CR-02 / 25-05).
CORS_ORIGINS=https://ilhacriativa.autopyweb.com.br

# Chaves de active_record_encryption (encrypts :token em whatsapp_instances) e
# segredo HMAC do webhook Evolution (assinatura, PAIR-06). Geradas com
# `bin/rails db:encryption:init`. OBRIGATORIAS em prod (boot-fatal); sem fallback
# para credentials.yml.enc. Em test/CI sem essas vars o encrypts vira no-op.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
EVOLUTION_WEBHOOK_HMAC_KEY=
EVOLUTION_WEBHOOK_BASE_URL=https://ilhacriativa.autopyweb.com.br

# --- solid_queue: retencao de failed_executions - fase 30 / INFRA-07 ---
# Janela (dias) para podar solid_queue_failed_executions, cujas linhas guardam
# os argumentos do job (referencias de grupo/divulgacao) em texto claro; a
# poda roda diariamente em producao e development (config/recurring.yml).
SOLID_QUEUE_FAILED_RETENTION_DAYS=14

# Portas do host para o proxy Caddy (default 80 / 443). Mude se ocupadas.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
