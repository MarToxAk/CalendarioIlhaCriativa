#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  system! "bin/rails db:reset" if ARGV.include?("--reset")

  # solid_queue em development (INFRA-02): as tabelas solid_queue_* precisam existir na base
  # primária de dev (config.solid_queue.connects_to é production-only). Passo idempotente.
  # WR-06: DEPOIS do `db:reset --reset` — db:reset roda db:drop + db:setup, que recarrega só
  # db/schema.rb e derrubaria as tabelas solid_queue_* recém-carregadas (elas vivem em
  # db/queue_schema.rb). Carregar a fila por último deixa o estado final com as tabelas.
  puts "\n== Carregando o schema da fila (solid_queue) na base de development =="
  if system("bin/rails", "db:schema:load:queue", out: File::NULL, err: File::NULL)
    puts "   schema da fila carregado via db:schema:load:queue"
  else
    system!("bin/rails", "runner", <<~'RUBY'.strip)
      if ActiveRecord::Base.connection.table_exists?(:solid_queue_jobs)
        puts "   tabelas solid_queue_* já presentes — nada a fazer"
      else
        load Rails.root.join("db/queue_schema.rb")
        puts "   db/queue_schema.rb carregado na base primária de development"
      end
    RUBY
  end

  # solid_cable em development (fase 30 / ACOMP-01): a tabela solid_cable_messages precisa
  # existir na base primária de dev (config.solid_cable so tem connects_to em production).
  # Mesmo tratamento idempotente do bloco solid_queue acima.
  puts "\n== Carregando o schema do cable (solid_cable) na base de development =="
  if system("bin/rails", "db:schema:load:cable", out: File::NULL, err: File::NULL)
    puts "   schema do cable carregado via db:schema:load:cable"
  else
    system!("bin/rails", "runner", <<~'RUBY'.strip)
      if ActiveRecord::Base.connection.table_exists?(:solid_cable_messages)
        puts "   tabela solid_cable_messages já presente — nada a fazer"
      else
        load Rails.root.join("db/cable_schema.rb")
        puts "   db/cable_schema.rb carregado na base primária de development"
      end
    RUBY
  end

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
